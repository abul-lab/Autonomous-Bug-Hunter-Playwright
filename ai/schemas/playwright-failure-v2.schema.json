{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antigravity.qe/schemas/pfd-v2.0.json",
  "title": "PlaywrightFailureRecordV2",
  "description": "Playwright Failure Dataset (PFD-v2.0) Schema with temporal preceding actions, DOM neighborhood, hydration context, and cryptographic governance.",
  "type": "object",
  "required": [
    "failureId",
    "timestamp",
    "browser",
    "page",
    "route",
    "errorMessage",
    "normalizedError",
    "rootCauseCategory",
    "verificationStatus",
    "governanceMetadata"
  ],
  "properties": {
    "failureId": { "type": "string", "pattern": "^fail_[a-zA-Z0-9_-]{8,32}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "browser": {
      "type": "object",
      "required": ["name", "version", "viewport", "os"],
      "properties": {
        "name": { "type": "string", "enum": ["chromium", "firefox", "webkit"] },
        "version": { "type": "string" },
        "viewport": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer" },
            "height": { "type": "integer" }
          }
        },
        "os": { "type": "string" }
      }
    },
    "page": {
      "type": "object",
      "required": ["url", "title"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "title": { "type": "string" },
        "routePattern": { "type": "string" }
      }
    },
    "route": { "type": "string" },
    "workflow": {
      "type": "object",
      "properties": {
        "journeyId": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "stepIndex": { "type": "integer" }
      }
    },
    "errorMessage": { "type": "string" },
    "normalizedError": {
      "type": "object",
      "required": ["signature", "cleanedMessage", "salientTokens"],
      "properties": {
        "signature": { "type": "string" },
        "cleanedMessage": { "type": "string" },
        "salientTokens": { "type": "array", "items": { "type": "string" } }
      }
    },
    "precedingActionTrail": {
      "type": "array",
      "description": "The last 3 to 5 atomic actions immediately preceding the failure.",
      "items": {
        "type": "object",
        "required": ["actionType", "deltaMs"],
        "properties": {
          "actionType": { "type": "string" },
          "selector": { "type": "string" },
          "payload": { "type": "string" },
          "deltaMs": { "type": "integer" }
        }
      }
    },
    "domFragmentAtFailure": {
      "type": "object",
      "properties": {
        "outerHtml": { "type": "string" },
        "parentTag": { "type": "string" },
        "computedStyles": {
          "type": "object",
          "properties": {
            "visibility": { "type": "string" },
            "display": { "type": "string" },
            "opacity": { "type": "string" },
            "zIndex": { "type": "string" },
            "pointerEvents": { "type": "string" }
          }
        }
      }
    },
    "frameworkState": {
      "type": "object",
      "properties": {
        "framework": { "type": "string", "enum": ["nextjs", "react", "angular", "vue", "vanilla"] },
        "isHydrated": { "type": "boolean" },
        "activePendingRequests": { "type": "integer" }
      }
    },
    "stackTrace": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "column": { "type": "integer" },
          "method": { "type": "string" }
        }
      }
    },
    "screenshotMetadata": {
      "type": "object",
      "properties": {
        "sha256": { "type": "string" },
        "storagePath": { "type": "string" },
        "dimensions": { "type": "string" },
        "mimeType": { "type": "string" },
        "imageEmbeddingSiglip": {
          "type": "array",
          "items": { "type": "number" },
          "description": "Precomputed 768-dimensional SigLIP/CLIP dense image embedding."
        }
      }
    },
    "traceMetadata": {
      "type": "object",
      "properties": {
        "traceZipPath": { "type": "string" },
        "actionsCount": { "type": "integer" },
        "networkRequestsCount": { "type": "integer" }
      }
    },
    "consoleLogs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "level": { "type": "string" },
          "text": { "type": "string" },
          "timestamp": { "type": "string" }
        }
      }
    },
    "networkSummary": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method": { "type": "string" },
          "url": { "type": "string" },
          "statusCode": { "type": "integer" },
          "durationMs": { "type": "number" },
          "errorText": { "type": "string" }
        }
      }
    },
    "rootCauseCategory": {
      "type": "string",
      "enum": [
        "LocatorDrift", "TimingIssue", "AuthenticationFailure",
        "EnvironmentFailure", "BackendApiFailure", "TestDataFailure",
        "VisualRegression", "AssertionFailure", "Unknown"
      ]
    },
    "remediationRecommendation": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "verificationStatus": {
      "type": "string",
      "enum": ["unverified", "ai_proposed", "human_verified", "rejected", "quarantined"]
    },
    "curationMetadata": {
      "type": "object",
      "properties": {
        "reviewedBy": { "type": "string" },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "governanceMetadata": {
      "type": "object",
      "required": ["piiScan", "secretScan", "screenshotAudit", "publicationApproval"],
      "properties": {
        "piiScan": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": { "type": "string", "enum": ["PASSED", "FLAGGED", "FAILED"] },
            "scanner": { "type": "string" },
            "redactionsCount": { "type": "integer" }
          }
        },
        "secretScan": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": { "type": "string", "enum": ["PASSED", "FLAGGED", "FAILED"] },
            "scanner": { "type": "string" },
            "secretsDetected": { "type": "integer" }
          }
        },
        "screenshotAudit": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": { "type": "string", "enum": ["PASSED", "PENDING", "REDACTED", "REJECTED"] },
            "ocrScanned": { "type": "boolean" },
            "auditedBy": { "type": "string" }
          }
        },
        "publicationApproval": {
          "type": "object",
          "required": ["approvedForInternalTraining", "approvedForPublicRelease"],
          "properties": {
            "approvedForInternalTraining": { "type": "boolean" },
            "approvedForPublicRelease": { "type": "boolean" },
            "signedBy": { "type": "string" },
            "decisionTimestamp": { "type": "string", "format": "date-time" }
          }
        }
      }
    }
  }
}

